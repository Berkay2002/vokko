{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Vokko",
  "version": "0.1.0",
  "identifier": "app.vokko.desktop",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [{ "label": "main", "title": "Vokko", "width": 1440, "height": 900, "minWidth": 800, "minHeight": 550 }],
    "security": {
      "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; connect-src ipc: http://ipc.localhost"
    }
  },
  "bundle": { "active": false, "icon": ["icons/icon.png", "icons/icon.ico", "icons/icon.icns"] }
}
