# Copy to deploy/.env (never commit it). Placeholders only.

# Database password. Use letters and digits only (e.g. `openssl rand -hex 24`): it is embedded in DATABASE_URL unescaped.
POSTGRES_PASSWORD=change-me

# The URL clients use to reach the server, no trailing slash. Used for attachment links and baked into the web client.
#   server only:       http://localhost:8710
#   with the web stack: https://chat.example.com  (or http://localhost for a local trial)
VOKKO_PUBLIC_URL=http://localhost:8710

# Per-file upload limit in MiB (default 25).
VOKKO_MAX_UPLOAD_MB=25

# Link previews fetch pages from your server's network. `off` disables all outbound requests.
VOKKO_UNFURL=on
# GIF picker: klipy | giphy | tenor | none (none = favourites only). The key stays on the server.
VOKKO_GIF_PROVIDER=none
VOKKO_GIF_API_KEY=

# Set to `on` when the server sits behind Caddy/nginx (so rate limits see real client addresses). Leave `off` if clients
# can reach the server port directly: with it on they could spoof their address.
VOKKO_TRUST_PROXY=off

# Uploads: `local` (the vokko-data volume) or `s3` (R2, B2, Supabase Storage, MinIO...; see docs/self-hosting-free.md).
VOKKO_STORAGE=local
VOKKO_S3_ENDPOINT=
VOKKO_S3_BUCKET=
VOKKO_S3_REGION=auto
VOKKO_S3_ACCESS_KEY_ID=
VOKKO_S3_SECRET_ACCESS_KEY=
# proxy (stream through the server) | presigned (redirect to a short-lived bucket URL)
VOKKO_S3_SERVE=proxy
VOKKO_S3_PRESIGN_TTL_SECS=300
# Object keys are <prefix><attachment id>, the same names as the files under the local data volume.
VOKKO_S3_PREFIX=attachments/

# Database pool size; lower it on free tiers with small connection limits.
VOKKO_DB_MAX_CONNECTIONS=10

# Where the server port is published on the host.
VOKKO_SERVER_LISTEN=127.0.0.1:8710

# --- web profile (docker compose --profile web ...) ---
# `:80` = HTTP only. A domain name (matching VOKKO_PUBLIC_URL) = Caddy gets certificates automatically (needs ports 80 and 443 open).
VOKKO_SITE_ADDRESS=:80
VOKKO_WEB_HTTP_PORT=80
VOKKO_WEB_HTTPS_PORT=443

RUST_LOG=vokko_server=info,warn
