# Copy to deploy/.env (never commit it). Placeholders only.

# Database password. Use letters and digits only (e.g. `openssl rand -hex 24`): it is embedded in DATABASE_URL unescaped.
POSTGRES_PASSWORD=change-me

# The URL clients use to reach the server, no trailing slash. Used for attachment links and baked into the web client.
#   server only:       http://localhost:8710
#   with the web stack: https://chat.example.com  (or http://localhost for a local trial)
VOKKO_PUBLIC_URL=http://localhost:8710

# Per-file upload limit in MiB (default and maximum 500, Nitro's limit; set it lower to save disk).
VOKKO_MAX_UPLOAD_MB=500

# Link previews fetch pages from your server's network. `off` disables all outbound requests.
VOKKO_UNFURL=on
# GIF picker: klipy | giphy | tenor | none (none = favourites only). The key stays on the server.
VOKKO_GIF_PROVIDER=none
VOKKO_GIF_API_KEY=

# Set to `on` when the server sits behind Caddy/nginx (so rate limits see real client addresses). Leave `off` if clients
# can reach the server port directly: with it on they could spoof their address.
VOKKO_TRUST_PROXY=off

# Uploads: `local` (the vokko-data volume) or `s3` (R2, B2, Supabase Storage, MinIO...; see docs/self-hosting-free.md).
VOKKO_STORAGE=local
VOKKO_S3_ENDPOINT=
VOKKO_S3_BUCKET=
VOKKO_S3_REGION=auto
VOKKO_S3_ACCESS_KEY_ID=
VOKKO_S3_SECRET_ACCESS_KEY=
# proxy (stream through the server) | presigned (redirect to a short-lived bucket URL)
VOKKO_S3_SERVE=proxy
VOKKO_S3_PRESIGN_TTL_SECS=300
# Object keys are <prefix><attachment id>, the same names as the files under the local data volume.
VOKKO_S3_PREFIX=attachments/

# `closed` makes POST /auth/register answer 403 (existing accounts keep working).
VOKKO_REGISTRATION=open

# Voice: all three or none (none = voice off). See docs/self-hosting.md "Voice (LiveKit)".
VOKKO_LIVEKIT_URL=
VOKKO_LIVEKIT_API_KEY=
VOKKO_LIVEKIT_API_SECRET=
# Optional: more LiveKit backends, used in order (multiple LiveKit backends with failover).
# Each is all three of URL, API_KEY, API_SECRET (API_URL and LABEL optional); `_3` works the same way.
# VOKKO_LIVEKIT_URL_2=
# VOKKO_LIVEKIT_API_KEY_2=
# VOKKO_LIVEKIT_API_SECRET_2=
# VOKKO_LIVEKIT_API_URL_2=
# VOKKO_LIVEKIT_LABEL_2=

# --- Stremio in calls (docs/self-hosting.md "Stremio in calls"; off unless every required key below is set) ---
# 32 random bytes, base64 (openssl rand -base64 32). Encrypts the users' Stremio keys; losing or changing it unlinks every account.
VOKKO_SECRETS_KEY=
# The second ("media") LiveKit that carries the movie, published through the Cloudflare tunnel. Not the voice LiveKit above.
VOKKO_MEDIA_LIVEKIT_URL=wss://live.vokko.example.com
VOKKO_MEDIA_LIVEKIT_API_KEY=
VOKKO_MEDIA_LIVEKIT_API_SECRET=
# What the native bot connects to instead (it runs next to that LiveKit); defaults to VOKKO_MEDIA_LIVEKIT_URL.
VOKKO_MEDIA_LIVEKIT_BOT_URL=ws://127.0.0.1:7880
# The native bot as the server container reaches it, and the shared secret (at least 16 characters; the bot gets the same one).
VOKKO_STREMIO_BOT_URL=http://host.internal:8720
VOKKO_STREMIO_BOT_SECRET=
# Optional: VOKKO_STREMIO=off, VOKKO_STREMIO_MAX_HEIGHT=1080 (144-1440), VOKKO_STREMIO_BITRATE_KBPS=6000 (100-20000),
# VOKKO_STREMIO_PAUSE_TIMEOUT_MIN=15, VOKKO_STREMIO_FETCH_ALLOW= (comma-separated IP ranges where a self-hosted addon may live).

# Database pool size; lower it on free tiers with small connection limits.
VOKKO_DB_MAX_CONNECTIONS=10

# Where the server port is published on the host.
VOKKO_SERVER_LISTEN=127.0.0.1:8710

# --- web profile (docker compose --profile web ...) ---
# `:80` = HTTP only. A domain name (matching VOKKO_PUBLIC_URL) = Caddy gets certificates automatically (needs ports 80 and 443 open).
VOKKO_SITE_ADDRESS=:80
VOKKO_WEB_HTTP_PORT=80
VOKKO_WEB_HTTPS_PORT=443
# Proxies Caddy may take X-Forwarded-For from. `private_ranges` only when cloudflared/nginx on this host or LAN is the
# sole way in (docs/self-hosting.md "Behind Cloudflare Tunnel"); leave the default when Caddy faces the internet.
VOKKO_TRUSTED_PROXIES=127.0.0.1/32

RUST_LOG=vokko_server=info,warn

# Host directory with the desktop installers served at /downloads/ (default deploy/downloads).
VOKKO_DOWNLOADS_DIR=./downloads
