# Used by deploy/web.Dockerfile. One origin for the SPA, REST and the gateway websocket, so the browser never makes a
# cross-origin request (the server's CORS allowlist is localhost/Tauri only).
{
	# Do not serve the admin API on a published container.
	admin off

	servers {
		# Off by default: X-Forwarded-For is ignored and the client is the TCP peer. Behind a proxy on this host or a private
		# network (cloudflared, nginx), set VOKKO_TRUSTED_PROXIES=private_ranges (or its CIDRs) so the client is the
		# rightmost untrusted X-Forwarded-For entry. Leave it unset when Caddy faces the internet itself: with Docker
		# Desktop/OrbStack every peer looks private, so trusting private ranges would let clients spoof the header.
		trusted_proxies static {$VOKKO_TRUSTED_PROXIES:127.0.0.1/32}
		trusted_proxies_strict
	}
}

{$VOKKO_SITE_ADDRESS::80} {
	encode zstd gzip

	# /internal/livekit/webhook is the only /internal path exposed: LiveKit Cloud must reach it and signs every call.
	@server path /api/* /gateway /healthz /internal/livekit/webhook
	handle @server {
		# Upgrades websockets automatically. The server reads the last X-Forwarded-For entry, so send the resolved client
		# rather than Caddy's default (which appends the immediate peer, i.e. the proxy in front of Caddy).
		reverse_proxy server:8710 {
			header_up X-Forwarded-For {client_ip}
		}
	}

	# Desktop installers from deploy/downloads on the host (docker-compose.yml). No listing; a missing file is a 404.
	handle_path /downloads/* {
		root * /downloads
		header Content-Disposition attachment
		# Revalidate every time: installers keep the same file name across releases, so an edge cache would serve stale builds.
		header Cache-Control "no-cache"
		file_server
	}

	handle {
		root * /srv
		try_files {path} /index.html
		file_server
		header /assets/* Cache-Control "public, max-age=31536000, immutable"
		# The web app's CSP, matching the packaged app's (release.production.json). frame-src https: because admins add game
		# origins at runtime (docs/design/games-host.md section 7). Not on pages other pages frame: the Watch Together embed
		# (loads YouTube's script, framed by the desktop app), the website game frame (framed by the macOS/Linux app, frames the
		# game) and the built-in games (framed by the app, carry their own rules).
		@app not path /youtube-embed.html /web-game.html /games/*
		header @app Content-Security-Policy "default-src 'self'; script-src 'self' 'wasm-unsafe-eval'; worker-src 'self' blob:; frame-src 'self' https:; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob: https://i.scdn.co https://images.metahub.space https://live.metahub.space https://episodes.metahub.space https://m.media-amazon.com; media-src 'self' blob:; connect-src 'self' https://*.livekit.cloud wss://*.livekit.cloud https://live.vokko.example.com wss://live.vokko.example.com; frame-ancestors 'none'"
		# Website game frame: only the desktop apps may frame it (it only obeys their postMessage anyway).
		header /web-game.html Content-Security-Policy "frame-ancestors tauri://localhost http://tauri.localhost https://tauri.localhost"
		# Built-in games: sandboxed (opaque origin even when opened directly), framed only by the app, no network.
		header /games/* Content-Security-Policy "sandbox allow-scripts allow-pointer-lock; frame-ancestors 'self'; default-src 'self'; connect-src 'none'; img-src 'self' data: blob:; style-src 'self' 'unsafe-inline'"
	}
}
